generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_aEtjbQ1oAk0y@ep-rapid-art-zavbruuw-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  createdAt  DateTime    @default(now())
  userMovies UserMovie[]
}

model Movie {
  id              String      @id @default(cuid())
  tmdbId          Int         @unique
  title           String
  originalTitle   String
  posterPath      String?
  backdropPath    String?
  releaseDate     DateTime?
  runtime         Int?
  director        String?
  genresJson      String      @default("[]")
  castJson        String      @default("[]")
  overview        String?
  tmdbVoteAverage Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userMovies      UserMovie[]

  @@index([title])
  @@index([originalTitle])
  @@index([releaseDate])
}

model UserMovie {
  id           String         @id @default(cuid())
  userId       String
  movieId      String
  favorite     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie        Movie          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  watchHistory WatchHistory[]

  @@unique([userId, movieId])
  @@index([userId, favorite])
  @@index([movieId])
}

model WatchHistory {
  id          String    @id @default(cuid())
  userMovieId String
  watchedAt   DateTime
  rating      Float
  review      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userMovie   UserMovie @relation(fields: [userMovieId], references: [id], onDelete: Cascade)

  @@index([userMovieId, watchedAt])
  @@index([rating])
}
